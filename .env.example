# ── DeepSeek API 配置 ─────────────────────────────
# 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 服务配置 ──────────────────────────────────────
PORT=3000

# ── 安全配置 ──────────────────────────────────────
# AI 执行命令的工作目录(建议限定在某个文件夹,防止乱动系统)
AGENT_WORKDIR=C:\Users\MECHREVO\.astrbot\data\workspaces\webchat_FriendMessage_webchat_astrbot_d2fbe9c1-5d86-4964-a8d7-ec51f2f9cb62\agent-home

# AI 一句话最多允许多少步工具调用(防止死循环)
MAX_TOOL_ROUNDS=8

# 是否允许 AI 执行 shell 命令(1=允许 0=禁止)
ALLOW_SHELL=1

# 危险命令是否需要人工确认(1=需要 0=直接拦截)
REQUIRE_CONFIRM=1
